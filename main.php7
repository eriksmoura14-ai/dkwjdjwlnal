<?php
class retangulo {
    private $largura;
    private $altura;

    public function __construct($altura, $largura) {
        $this->altura = $altura;
        $this->largura = $largura;
    }
       public function calcularArea() {
        return $this->altura * $this->largura;
       }
         public function calcularperimetro() {
             return $this ->altura + $this ->largura;
         }
}

$retangulo = new Retangulo(12, 18.5);
echo $retangulo -> calcularArea() . "\n";
echo $retangulo -> calcularperimetro();
